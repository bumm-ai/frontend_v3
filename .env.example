# ── Bumm Frontend v3 — proxy to FastAPI backend ─────────────────────────────
# Copy to .env.local (never commit secrets)

# Target for Next.js route: src/app/api/backend/[...path]/route.ts
# Local backend_v3 (typical): http://127.0.0.1:8080
# Production API: https://api.example.com
BACKEND_URL=http://127.0.0.1:8080

# Optional: public URL for docs / health checks (not used by proxy unless you wire it)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
